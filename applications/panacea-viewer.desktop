[Desktop Entry]
Type=Application
Name=Image Viewer
GenericName=Image Viewer
Comment=Images and video in the island, with trim and crop
Icon=panacea-viewer
Exec=panacea-island media %f
Terminal=false
NoDisplay=true
Categories=Graphics;Viewer;
