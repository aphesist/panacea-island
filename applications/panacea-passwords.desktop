[Desktop Entry]
Type=Application
Name=Passwords
GenericName=Password Manager
Comment=Your Proton Pass logins in the island
Icon=panacea-passwords
Exec=sh -c "qs -p \\$HOME/.config/panacea ipc call pill passwords"
Terminal=false
Categories=Utility;Security;
Keywords=password;passwords;vault;login;proton;pass;keys;
StartupNotify=false
