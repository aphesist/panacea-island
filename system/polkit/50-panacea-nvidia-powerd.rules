// panacea-island: the Performance power mode turns on NVIDIA Dynamic Boost (nvidia-powerd), the
// other modes turn it off. This lets an active, local wheel user start or stop that one service
// without a password prompt. Nothing else changes.
polkit.addRule(function (action, subject) {
    if (action.id == "org.freedesktop.systemd1.manage-units" &&
        action.lookup("unit") == "nvidia-powerd.service" &&
        (action.lookup("verb") == "start" || action.lookup("verb") == "stop") &&
        subject.local && subject.active && subject.isInGroup("wheel")) {
        return polkit.Result.YES;
    }
});
